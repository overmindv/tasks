SERVICE_NAME=tasks
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tasks?sslmode=disable
LOG_LEVEL=debug
ENV=local
READ_TIMEOUT=10s
WRITE_TIMEOUT=20s
TASK_HUNTER_INGEST_TOKEN=replace-with-a-long-random-ingest-token
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_REQUESTS_TOPIC=code-execution.requests.v1
KAFKA_RESULTS_TOPIC=code-execution.results.v1
KAFKA_RESULTS_CONSUMER_GROUP=tasks-code-results-v1
KAFKA_OUTBOX_POLL_INTERVAL=500ms
CODE_EXECUTION_TIME_LIMIT=1s
CODE_EXECUTION_MEMORY_LIMIT_BYTES=67108864
