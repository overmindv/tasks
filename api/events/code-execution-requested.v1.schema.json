{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overmindv.local/schemas/code-execution-requested.v1.schema.json",
  "title": "code_execution.requested v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "correlation_id",
    "submission_id",
    "execution_id",
    "task_id",
    "task_version_id",
    "language",
    "source",
    "tests",
    "limits"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "code_execution.requested" },
    "schema_version": { "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string", "format": "uuid" },
    "submission_id": { "type": "string", "format": "uuid" },
    "execution_id": { "type": "string", "format": "uuid" },
    "task_id": { "type": "string", "format": "uuid" },
    "task_version_id": { "type": "string", "format": "uuid" },
    "language": { "enum": ["python", "go"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "content"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "content": { "type": "string", "minLength": 1, "maxLength": 262144 }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "visibility", "input", "expected_output"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "visibility": { "const": "open" },
          "input": { "type": "string" },
          "expected_output": { "type": "string", "minLength": 1 }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_ms", "memory_bytes"],
      "properties": {
        "time_ms": { "type": "integer", "minimum": 1 },
        "memory_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
