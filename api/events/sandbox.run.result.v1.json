      "user_id": "33333333-3333-4333-8333-333333333333",
      "task_id": "44444444-4444-4444-8444-444444444444",
      "language": {
        "id": "python",
        "version": "3.12"
      },
      "status": "ok",
      "summary": {
        "cases_total": 1,
        "cases_with_error": 0,
        "tests_total": 0,
        "tests_passed": 0,
        "tests_failed": 0
      },
      "timing": {
        "queue_ms": 12,
        "prepare_ms": 8,
        "run_ms": 431,
